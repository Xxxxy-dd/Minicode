# MiniCode Agent V1 environment template

# OpenAI-compatible model settings.
MINICODE_MODEL=gpt-4.1-mini
MINICODE_MODEL_API_KEY=replace-with-your-api-key
MINICODE_MODEL_BASE_URL=https://api.openai.com/v1

# Optional: extra skill roots. Separate multiple paths with ';' on Windows.
# Workspace skills under .minicode/skills are loaded automatically.
MINICODE_SKILL_PATHS=examples/skills
